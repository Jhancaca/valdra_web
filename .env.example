# URL server-side del backend Spree. Nunca use NEXT_PUBLIC_ para secretos.
SPREE_API_URL=
SPREE_PUBLISHABLE_KEY=
# Solo se utilizará desde Rails/Active Storage para Supabase Storage.
SUPABASE_DATABASE_URL=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=catalog-public
SUPABASE_PRIVATE_BUCKET=catalog-private
SUPABASE_STORAGE_REGION=us-east-1
